generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id
  email    String   @unique
  name     String
  charges  Charge[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Charge {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal
  description String?
  createdAt   DateTime @default(now())
}

